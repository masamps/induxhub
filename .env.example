# Saída de `npx supabase status` (local) ou Project Settings > API (remoto).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL pública do site, usada em metadados e links absolutos.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Só servidor. Teste/preview sem SMTP: AUTH_AUTOCONFIRM=true cria a conta já
# confirmada, sem enviar e-mail. Exige a service role. Nunca em produção.
AUTH_AUTOCONFIRM=false
SUPABASE_SERVICE_ROLE_KEY=
